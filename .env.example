# Settings for the API server (python -m arcanum.server). Every value is optional;
# the defaults are shown.

# Where the server listens
ARCANUM_HOST=127.0.0.1
ARCANUM_PORT=8000

# Browser origins allowed to call the API (comma-separated)
ARCANUM_ALLOWED_ORIGINS=http://localhost:5173

# Where session databases are stored (defaults to <system temp dir>/arcanum-sessions)
ARCANUM_DATA_DIR=

# Session limits
ARCANUM_MAX_SESSIONS=20
ARCANUM_SESSION_TTL=1800

# Per-statement and per-database limits
ARCANUM_QUERY_TIMEOUT=10
ARCANUM_MAX_PAGES=2500
ARCANUM_MAX_ROWS=1000
ARCANUM_MAX_SQL_BYTES=20000
ARCANUM_EVENT_LIMIT=20000

# Engine tuning for the demo: small B+tree nodes make splits easy to see
ARCANUM_MAX_KEYS=4
ARCANUM_POOL_SIZE=64
