# Settings for the API server (python -m arcanum.server). Every value is optional;
# the defaults are shown.

# Where the server listens (PORT, when a host such as Render sets it, takes precedence over
# ARCANUM_PORT), and which proxies may report the client address (X-Forwarded-For). List proxy
# addresses or networks; never "*", which would let clients forge their address.
ARCANUM_HOST=127.0.0.1
ARCANUM_PORT=8000
ARCANUM_TRUSTED_PROXIES=127.0.0.1

# Browser origins allowed to call the API (comma-separated). The page that serves the UI is always allowed.
ARCANUM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where session databases are stored (defaults to <system temp dir>/arcanum-sessions)
ARCANUM_DATA_DIR=
# Built web UI to serve from / (defaults to web/dist in the repository)
ARCANUM_WEB_DIR=

# Sessions
ARCANUM_MAX_SESSIONS=20
ARCANUM_MAX_SESSIONS_PER_CLIENT=2
ARCANUM_SESSION_TTL=1800

# Per-client rate limits
ARCANUM_RATE_PER_SECOND=10
ARCANUM_RATE_BURST=40
ARCANUM_SESSIONS_PER_MINUTE=4
ARCANUM_CRASHES_PER_MINUTE=6

# Connections
ARCANUM_MAX_CONNECTIONS=500
ARCANUM_MAX_WEBSOCKETS=200
ARCANUM_MAX_WEBSOCKETS_PER_CLIENT=4
ARCANUM_MAX_WEBSOCKETS_PER_SESSION=4

# Statements
ARCANUM_QUERY_TIMEOUT=10
ARCANUM_QUEUE_TIMEOUT=5
# Defaults to the number of CPU cores (at least 2)
ARCANUM_MAX_CONCURRENT_QUERIES=
ARCANUM_MAX_SQL_BYTES=20000
ARCANUM_MAX_ROWS=1000
ARCANUM_MEMORY_ROWS=200000
ARCANUM_SORT_MEMORY_ROWS=10000
ARCANUM_SPILL_BYTES=67108864
ARCANUM_RECURSIVE_ROWS=100000
ARCANUM_EVENT_LIMIT=20000

# Per-session database and worker
ARCANUM_MAX_PAGES=2500
ARCANUM_WORKER_MEMORY_MB=768

# Engine tuning for the demo: small B+tree nodes make splits easy to see
ARCANUM_MAX_KEYS=4
ARCANUM_POOL_SIZE=64

# Off by default: interactive API docs, access logs (URLs carry session ids), HSTS (enable behind HTTPS)
ARCANUM_ENABLE_DOCS=0
ARCANUM_ACCESS_LOG=0
ARCANUM_HSTS=0
